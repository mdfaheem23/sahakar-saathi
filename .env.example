# Copy to .env and fill in. Never commit .env.

# Sarvam AI — speech-to-text and text-to-speech for all six languages.
SARVAM_API_KEY=

# Mistral — embeddings (mistral-embed, 1024-dim) and answer generation.
# mistral-large-latest is gated behind a paid tier; the code defaults to
# mistral-medium-latest, which works on the free tier.
MISTRAL_API_KEY=
# MISTRAL_CHAT_MODEL=mistral-medium-latest

# Pinecone — hosted vector store for the RAG corpus.
# Optional: with no key set, retrieval falls back to in-process embeddings,
# which is what keeps the offline kiosk working.
#   1. create a free account at https://app.pinecone.io
#   2. create a serverless index: dimension 1024, metric cosine
#   3. put the key and index name here, then run: npm run index:corpus
PINECONE_API_KEY=
PINECONE_INDEX=pacs-sahayak

# Vercel Cron — shared secret for /api/cron/check-sources.
# Optional locally; set it in production so only Vercel Cron can invoke the job.
CRON_SECRET=

# Where the daily source check reports a changed document or a dead
# application portal. Any endpoint that accepts { "text": "..." } — a Slack or
# Google Chat incoming webhook, or a departmental notifier.
# Optional: without it the check still raises the flag on every channel, but
# nobody is told, so it stays up until someone opens the admin dashboard.
SOURCE_ALERT_WEBHOOK=

# Government sources currently under doubt, as a JSON array. Applied on top of
# the committed lib/sources/alerts.json, so a scheme can be flagged across the
# whole fleet in minutes without a redeploy — which is what you need at 9pm
# when a scheme is withdrawn and the kiosks are still answering questions
# about it. The cron response hands you the exact value to paste here.
#   [{"sourceId":"pmfby-operational-guidelines","kind":"source-changed",
#     "detectedOn":"2026-09-02","detail":"Guidelines PDF revised."}]
SOURCE_ALERTS=

# Signing key for printed kiosk receipts. Without it receipts are signed with a
# development key and prove nothing, so a forged printout would pass. Set a
# long random value per state fleet before any pilot.
RECEIPT_SECRET=

# Set to 1 to stop each running instance re-verifying the government sources
# for itself every six hours. Only for local development against a slow link —
# with it set, a document that changes between deployments is not noticed until
# the daily cron runs and someone acts on the alert by hand.
DISABLE_LIVE_SOURCE_CHECK=
