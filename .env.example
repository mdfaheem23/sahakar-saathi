# Copy to .env and fill in. Never commit .env.
# Every provider is optional except one chat model: with only SARVAM_API_KEY
# set, the whole app runs.

# ── Answer generation ───────────────────────────────────────────────
# BharatGen Param-2 (primary), served with vLLM's OpenAI-compatible API:
#   vllm serve bharatgenai/Param2-17B-A2.4B-Thinking --api-key <key>
PARAM2_BASE_URL=
PARAM2_API_KEY=
# PARAM2_MODEL=bharatgenai/Param2-17B-A2.4B-Thinking
# How long to wait on Param-2 before asking the backup, in ms.
# PARAM2_TIMEOUT_MS=12000

# Sarvam — backup for generation, speech and translation.
SARVAM_API_KEY=
# SARVAM_CHAT_MODEL=sarvam-105b-conversations

# ── Speech and translation ──────────────────────────────────────────
# Bhashini (primary). Register at https://bhashini.gov.in/ulca and generate
# an API key under your profile.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# BHASHINI_TTS_GENDER=female

# ── Retrieval ───────────────────────────────────────────────────────
# Embeddings run in-process (multilingual-e5); no key needed.
# EMBED_MODEL=Xenova/multilingual-e5-small
# MIN_SIMILARITY=0.817   # re-tune with npm run tune:threshold if you change the model

# ── Database (Supabase) ─────────────────────────────────────────────
# Hosts the pgvector index. Optional: without it, retrieval uses the
# in-process vectors baked into lib/rag/vectors.json.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Long random value; its SHA-256 is stored in private.config in the database.
# Required for npm run index:corpus to write pgvector.
SUPABASE_ADMIN_SECRET=

# ── Source monitoring ───────────────────────────────────────────────
# Vercel Cron — shared secret for /api/cron/check-sources.
# Optional locally; set it in production so only Vercel Cron can invoke the job.
CRON_SECRET=

# Where the daily source check reports a changed document or a dead
# application portal. Any endpoint that accepts { "text": "..." } — a Slack or
# Google Chat incoming webhook, or a departmental notifier.
SOURCE_ALERT_WEBHOOK=

# Government sources currently under doubt, as a JSON array. Applied on top of
# the committed lib/sources/alerts.json, so a scheme can be flagged across the
# whole fleet in minutes without a redeploy.
#   [{"sourceId":"pmfby-operational-guidelines","kind":"source-changed",
#     "detectedOn":"2026-09-02","detail":"Guidelines PDF revised."}]
SOURCE_ALERTS=

# Signing key for printed kiosk receipts. Without it receipts are signed with a
# development key and prove nothing. Set a long random value before any pilot.
RECEIPT_SECRET=

# Set to 1 to stop each instance re-verifying government sources every six
# hours. Local development only.
DISABLE_LIVE_SOURCE_CHECK=
